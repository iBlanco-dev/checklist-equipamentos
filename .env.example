PORT=3000
# Em produção (hospedagem com proxy via socket unix), defina SOCKET_PATH
# em vez de depender de PORT. Quando SOCKET_PATH está setado, o server
# escuta nesse arquivo de socket em vez de uma porta TCP.
# SOCKET_PATH=/caminho/para/etc/nodejs/nodejs.sock

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=checklist

JWT_SECRET=troque-por-uma-chave-secreta-forte

# URL pública do frontend, usada para montar o link de redefinição de senha
FRONTEND_URL=http://localhost:5173

# SMTP para envio de e-mail de redefinição de senha.
# Se SMTP_HOST não for definido, o link é apenas logado no console (modo dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@checklist.local
